{
  "name": "Medical KG QA API test data",
  "description": "These cases can be used against either web_app/server.py or web_app/fastapi_server.py. Start one server at a time on the same base_url.",
  "base_url": "http://127.0.0.1:8000",
  "debug_targets": [
    {
      "name": "stdlib_server",
      "vscode_launch": "Debug web_app/server.py",
      "entry": "web_app/server.py"
    },
    {
      "name": "fastapi_server",
      "vscode_launch": "Debug FastAPI web_app",
      "entry": "web_app/fastapi_server.py",
      "docs_url": "http://127.0.0.1:8000/docs",
      "openapi_url": "http://127.0.0.1:8000/openapi.json"
    }
  ],
  "cases": [
    {
      "name": "service_status",
      "group": "common",
      "description": "Check web service status.",
      "method": "GET",
      "path": "/api/status",
      "expected": {
        "status": 200,
        "ok": true,
        "code": "OK",
        "data.service": "Medical KG QA Studio"
      }
    },
    {
      "name": "session_status",
      "group": "common",
      "description": "Check active session count.",
      "method": "GET",
      "path": "/api/session/status",
      "expected": {
        "status": 200,
        "ok": true,
        "code": "OK"
      }
    },
    {
      "name": "fastapi_openapi_schema",
      "group": "fastapi_only",
      "description": "FastAPI OpenAPI schema endpoint. Only available when using web_app/fastapi_server.py.",
      "method": "GET",
      "path": "/openapi.json",
      "expected": {
        "status": 200,
        "info.title": "Medical KG QA Studio"
      }
    },
    {
      "name": "rule_disease_symptom",
      "group": "rule_based",
      "description": "Rule-based QA: disease symptoms.",
      "method": "POST",
      "path": "/api/rule/chat",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "question": "乳腺癌的症状有哪些？"
      },
      "expected": {
        "status": 200,
        "ok": true,
        "code": "OK",
        "data.mode": "rule_based",
        "data.question": "乳腺癌的症状有哪些？"
      }
    },
    {
      "name": "rule_disease_not_food",
      "group": "rule_based",
      "description": "Rule-based QA: food restrictions for a disease.",
      "method": "POST",
      "path": "/api/rule/chat",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "question": "高血压不能吃什么？"
      },
      "expected": {
        "status": 200,
        "ok": true,
        "code": "OK",
        "data.mode": "rule_based"
      }
    },
    {
      "name": "rule_disease_drug",
      "group": "rule_based",
      "description": "Rule-based QA: drugs for a disease.",
      "method": "POST",
      "path": "/api/rule/chat",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "question": "感冒要吃什么药？"
      },
      "expected": {
        "status": 200,
        "ok": true,
        "code": "OK",
        "data.mode": "rule_based"
      }
    },
    {
      "name": "rule_check_disease",
      "group": "rule_based",
      "description": "Rule-based QA: diseases found by a medical check.",
      "method": "POST",
      "path": "/api/rule/chat",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "question": "血常规能查出什么病？"
      },
      "expected": {
        "status": 200,
        "ok": true,
        "code": "OK",
        "data.mode": "rule_based"
      }
    },
    {
      "name": "llm_disease_property_with_session",
      "group": "llm_based",
      "description": "LLM-based QA with an explicit session id.",
      "method": "POST",
      "path": "/api/llm/chat",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "question": "乳腺癌如何治疗？",
        "session_id": "debug-memory-001"
      },
      "expected": {
        "status": 200,
        "ok": true,
        "code": "OK",
        "data.mode": "llm_based",
        "data.session_id": "debug-memory-001",
        "data.debug.query_plan.subject.name": "乳腺癌"
      }
    },
    {
      "name": "memory_followup_seed",
      "group": "memory",
      "sequence": 1,
      "description": "First request for memory and follow-up rewrite tests.",
      "method": "POST",
      "path": "/api/llm/chat",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "question": "高血压不能吃什么？",
        "session_id": "debug-memory-002"
      },
      "expected": {
        "status": 200,
        "ok": true,
        "code": "OK",
        "data.mode": "llm_based",
        "data.session_id": "debug-memory-002",
        "data.debug.query_plan.subject.name": "高血压"
      }
    },
    {
      "name": "memory_followup_question",
      "group": "memory",
      "sequence": 2,
      "description": "Follow-up request that should reuse the previous topic through session memory.",
      "method": "POST",
      "path": "/api/llm/chat",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "question": "那它适合吃什么？",
        "session_id": "debug-memory-002"
      },
      "expected": {
        "status": 200,
        "ok": true,
        "code": "OK",
        "data.mode": "llm_based",
        "data.session_id": "debug-memory-002",
        "data.original_question": "那它适合吃什么？",
        "data.debug.memory_context.current_topic.name": "高血压",
        "data.debug.query_plan.subject.name": "高血压"
      }
    },
    {
      "name": "memory_clear_session",
      "group": "memory",
      "sequence": 3,
      "description": "Clear the memory test session.",
      "method": "POST",
      "path": "/api/session/clear",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "session_id": "debug-memory-002"
      },
      "expected": {
        "status": 200,
        "ok": true,
        "code": "OK",
        "data.cleared": true
      }
    },
    {
      "name": "bad_request_empty_question_rule",
      "group": "error",
      "description": "Validation error for an empty question in rule mode.",
      "method": "POST",
      "path": "/api/rule/chat",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "question": ""
      },
      "expected": {
        "status": 400,
        "ok": false,
        "code": "BAD_REQUEST",
        "error.message": "question is required"
      }
    },
    {
      "name": "bad_request_empty_question_llm",
      "group": "error",
      "description": "Validation error for an empty question in LLM mode.",
      "method": "POST",
      "path": "/api/llm/chat",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "question": "",
        "session_id": "debug-memory-empty"
      },
      "expected": {
        "status": 400,
        "ok": false,
        "code": "BAD_REQUEST",
        "error.message": "question is required"
      }
    },
    {
      "name": "api_not_found",
      "group": "error",
      "description": "API 404 response. FastAPI and stdlib server both return the unified API response for API paths.",
      "method": "POST",
      "path": "/api/not-exists",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "question": "高血压是什么？"
      },
      "expected": {
        "status": 404,
        "ok": false,
        "code": "NOT_FOUND"
      }
    }
  ]
}
